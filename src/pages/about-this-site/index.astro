---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { staticPages } from '../../data/pages';
import { repoUrl } from '../../data/site';
import '../../styles/palette.css';
import { assertPalette, COLOUR_TOKENS, readResults, TOKEN_ROLES, TEXT_MIN, UI_MIN } from '../../lib/contrast';

// Worked out from src/styles/tokens.css each time the site is built. If any text
// pair is under 4.5:1 or any UI pair under 3:1, in either mode, this throws and
// the build fails.
const { palettes, results } = readResults();
assertPalette(results);
const modes = ['light', 'dark'] as const;
const upper = (word: string) => word.charAt(0).toUpperCase() + word.slice(1);
const ratio = (value: number) => `${value.toFixed(2)}:1`;
const standard = (kind: 'text' | 'ui') => (kind === 'text' ? `${TEXT_MIN}:1, text` : `${UI_MIN}:1, interface`);
const palettePage =
  'https://www.realtimecolors.com/?colors=12203d-f4f3ee-8a5700-e7e6df-4a5470&fonts=Cormorant%20Garamond-Newsreader';
---

<BaseLayout
  title={staticPages['about-this-site'].title}
  description={staticPages['about-this-site'].description}
>
  <div class="page-head">
    <h1>About this site</h1>
  </div>

  <section aria-labelledby="built-heading">
    <h2 id="built-heading">How it is built</h2>
    {/* Source: CLAUDE.md, Stack and Deploy model. */}
    <p>
      This is a static site built with Astro. I build it on my own machine and publish the built files to GitHub Pages.
    </p>
    {/* Source: CLAUDE.md non-negotiables, and site-standards.md. */}
    <p>
      The checks also run on my machine. The site has no analytics and no cookie banner, and it loads no third-party scripts.
    </p>
  </section>

  <section aria-labelledby="ai-heading">
    <h2 id="ai-heading">How AI is involved</h2>
    {/* Source: CLAUDE.md, Purpose: the site is built with Claude Code, with Brad directing, reviewing and deciding what ships. */}
    <p>
      I build this site with Claude Code, Anthropic's coding assistant. I direct the work, review the changes and decide what is
      published.
    </p>
    {/* Source: confirmed in the build session with Brad. */}
    <p>Claude Code wrote the code for this site. I chose what to build, judged the designs and reviewed what came back.</p>
    {/* Source: CLAUDE.md, Working with Brad: Brad is the only source of truth for Brad's career. */}
    <p>The facts about my career come from me. Claude Code is told not to invent details to fill a gap.</p>
  </section>

  <section id="colour" aria-labelledby="colour-heading">
    <link rel="stylesheet" href="/swatches.css" />
    <h2 id="colour-heading">Colour and readability</h2>
    {/* Source: the ratios are worked out from src/styles/tokens.css at build time (src/lib/contrast.ts). */}
    <p>
      The tables below show how much each pair of colours on this site contrasts, in light and dark. The ratios are worked out
      from the site's own colours whenever the site is built, so the numbers cannot drift from what you see.
    </p>
    {/* Source: WCAG 2.x: 4.5:1 for normal text, 3:1 for large text and user interface components. */}
    <p>
      Contrast compares how light two colours are. It runs from 1:1, no difference at all, to 21:1, which is black on white. The
      Web Content Accessibility Guidelines (WCAG) ask for at least 4.5:1 for normal text, and 3:1 for large text and interface
      parts such as the chart bars.
    </p>
    <p>
      Contrast matters because it keeps text readable for people with low vision, on dim or cheap screens, and in bright sunlight.
    </p>
    {/* Source: Brad chose this palette in chat (2 November 2026) */}
    <p>
      I compared six palettes, in light and dark, using{' '}
      <ExternalLink href="https://www.realtimecolors.com">Realtime Colors</ExternalLink> to see each one on a full page, and
      chose navy with an ochre accent. You can{' '}
      <ExternalLink href={palettePage}>see the chosen palette on Realtime Colors</ExternalLink>.
    </p>

    <h3 id="palette-heading">The palette</h3>
    <div class="swatches" role="group" aria-labelledby="palette-heading">
      {
        modes.map((mode) => (
          <div class={`swatches__panel swatches--${mode}`}>
            <h4>{upper(mode)}</h4>
            <ul class="swatches__list" aria-label={`${upper(mode)} colours`}>
              {COLOUR_TOKENS.map((name) => (
                <li>
                  <span class={`swatch swatch--${name}`} aria-hidden="true" />
                  <span class="swatches__role">{TOKEN_ROLES[name]}</span>
                  <span class="swatches__hex">{palettes[mode][name]}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <h3 id="contrast-heading">Contrast results</h3>
    {
      modes.map((mode) => (
        <section class="table-scroll" aria-labelledby={`contrast-${mode}-caption`} tabindex="0">
          <table class="contrast-table">
            <caption id={`contrast-${mode}-caption`}>{`Contrast ratios, ${mode} colours`}</caption>
            <thead>
              <tr>
                <th scope="col">Pair</th>
                <th scope="col">Ratio</th>
                <th scope="col">Standard</th>
                <th scope="col">Result</th>
              </tr>
            </thead>
            <tbody>
              {results[mode].map((r) => (
                <tr>
                  <th scope="row">
                    {r.label}
                    <span class="use">{r.use}</span>
                  </th>
                  <td>{ratio(r.ratio)}</td>
                  <td>{standard(r.kind)}</td>
                  <td class="result">{r.pass ? 'Pass' : 'Fail'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))
    }
    {/* Source: assertPalette in src/lib/contrast.ts, called while this page is built. */}
    <p>If a colour change ever drops a pair below the standard, the site won't build.</p>
  </section>

  <section aria-labelledby="public-heading">
    <h2 id="public-heading">The setup is public</h2>
    {/* Source: the repository: CLAUDE.md and the .claude folder (rules and skills). */}
    <p>
      The instructions Claude Code follows for this site are in the public{' '}
      <ExternalLink href={repoUrl}>repository on GitHub</ExternalLink>. They are a <code>CLAUDE.md</code> file, plus written rules
      and skills in the <code>.claude</code> folder.
    </p>
  </section>
</BaseLayout>
