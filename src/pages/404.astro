---
import BaseLayout from '../layouts/BaseLayout.astro';
import { staticPages } from '../data/pages';
---

<BaseLayout title={staticPages['404'].title} description={staticPages['404'].description} noindex>
  <div class="page-head">
    <h1>Page not found</h1>
    <p class="lede">That address does not match a page on this site. It may have moved, or the link may be wrong.</p>
    <p><a href="/">Go to the home page</a> or <a href="/work/">see the work</a>.</p>
  </div>
</BaseLayout>
