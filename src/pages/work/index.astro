---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';
import { staticPages } from '../../data/pages';
import { getWork } from '../../lib/work';

const entries = await getWork();
---

<BaseLayout title={staticPages.work.title} description={staticPages.work.description}>
  <div class="page-head">
    <h1>Work</h1>
  </div>
  <WorkList entries={entries} level={2} />
</BaseLayout>
