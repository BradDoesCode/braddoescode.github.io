---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/WorkList.astro';
import { getWork } from '../../lib/work';

const entries = await getWork();
---

<BaseLayout title="Work" description="Case studies by Bradley Barbrook, listed newest first.">
  <div class="page-head">
    <h1>Work</h1>
  </div>
  <WorkList entries={entries} level={2} />
</BaseLayout>
