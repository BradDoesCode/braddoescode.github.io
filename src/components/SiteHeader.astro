---
import { nav, siteName } from '../data/site';
import { hasPublishedNotes } from '../lib/notes';
import { hasPublishedWork } from '../lib/work';

const here = Astro.url.pathname;

// The Work and Notes links come back by themselves once a case study or a note is published.
const showWork = await hasPublishedWork();
const showNotes = await hasPublishedNotes();
const items = nav.filter(
  (item) => (showWork || item.href !== '/work/') && (showNotes || item.href !== '/notes/'),
);

function isCurrent(href: string) {
  return href === '/' ? here === '/' : here.startsWith(href);
}
---

<header class="site-header">
  <div class="wrap">
    <a class="site-name" href="/">{siteName}</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
