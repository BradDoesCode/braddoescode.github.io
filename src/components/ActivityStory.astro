---
// The Activity section's content: a title, a big multiplier, the annotated
// chart and, in the full version, a lede, stat and "what changed" rows and a
// note on how the chart is made. The compact version (home page) is the title,
// the big multiplier, the chart and two links. The page supplies the section
// and its "Activity" label.
//
// The only figures are rounded multipliers (average pull requests per week in a
// period against the average before April 2026), read from
// src/data/activity.json at build time so a refresh updates them. A multiplier
// that rounds to 1 or less is not shown. Never a count, an average or a total
// (confidentiality.md). The case-study link and the row that rests on it are
// drawn only when that case study is published.
import ActivityChart from './ActivityChart.astro';
import { shownMultipliers } from '../lib/activity';
import { getPublishedWork } from '../lib/work';

interface Props {
  variant?: 'full' | 'compact';
}

const { variant = 'full' } = Astro.props;
const full = variant === 'full';
const study = await getPublishedWork('job-visibility');
const studyHref = study ? `/work/${study.id}/` : undefined;

const multipliers = shownMultipliers();
const stat = multipliers.fromAugust;
const statRows = [
  { key: 'aprilToJuly', label: 'April–July 2026', value: multipliers.aprilToJuly },
  { key: 'fromAugust', label: 'From August 2026', value: multipliers.fromAugust },
].filter((row) => row.value !== undefined);
const basis = 'compared with before April 2026';
const chartNote = stat
  ? 'The multiplier compares average pull requests opened per week with the average before April 2026, rounded to the nearest whole number.'
  : undefined;
---

<div class:list={['activity-story', `activity-story--${variant}`]}>
  {/* Source: confirmed by Brad in chat (the title's "same job, same hours"). */}
  <h3 class="activity-story__headline">Same job, same hours, a different pace</h3>

  {
    stat !== undefined && (
      <p class="activity-story__stat">
        <span class="activity-story__figure">{stat}×</span>
        <span class="activity-story__stat-label">more pull requests a week since August, {basis}</span>
      </p>
    )
  }

  {
    full && (
      <p class="activity-story__lede">
        Once we started building with AI agents in April 2026, my pace picked up. It picked up again from August, once usage limits
        were no longer a constraint.
      </p>
    )
  }

  {
    full && statRows.length > 0 && (
      <dl class="activity-story__points activity-story__points--stats">
        {statRows.map((row) => (
          <div class="activity-story__point">
            <dt>{row.label}</dt>
            <dd>
              <span class="activity-story__figure activity-story__figure--row">{row.value}×</span> pull requests a week
              <span class="activity-story__basis">{basis}</span>
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  <ActivityChart variant={variant} caption={!full} limits note={chartNote} />

  {
    full && (
      <>
        <dl class="activity-story__points">
          <div class="activity-story__point">
            <dt>Pace</dt>
            {/* Source: Brad's own phrase, also used on the home page. */}
            <dd>Speed without compromise on quality.</dd>
          </div>
          <div class="activity-story__point">
            <dt>Judgement</dt>
            {/* Source: confirmed wording. */}
            <dd>People make the design decisions and review what ships.</dd>
          </div>
          {study && (
            <div class="activity-story__point">
              <dt>Visibility</dt>
              {/* Source: confirmed in the case study. */}
              <dd>
                Customer service can now <a href={studyHref}>see a stuck job before the customer asks about it</a>.
              </dd>
            </div>
          )}
        </dl>

        {study && (
          <p class="activity-story__practice">
            <a href={studyHref}>See it in practice: {study.data.title}</a>
          </p>
        )}

        <p class="activity-story__note">
          <strong>How this is measured.</strong>{' '}
          {/* Source: Brad's approved caption, with "shown relative to the busiest week" from the chart's own summary. */}
          Pull requests opened per week across my GitHub account, including private work, shown relative to the busiest week.
          It reflects how I work rather than output. The shift began when we started building with AI agents in April 2026, and
          picked up from August, once usage limits were no longer a constraint.{' '}
          {/* Source: confirmed by Brad in chat (22 October 2026): rounded multipliers against the average before April 2026. */}
          {(stat !== undefined || statRows.length > 0) &&
            'Multipliers compare average pull requests opened per week in each period with the average before April 2026, rounded to the nearest whole number. '}
          {/* Source: confirmed by Brad in chat */}
          Most of my work since April has been on newer projects, which grow faster than maintenance on a mature codebase.
        </p>
      </>
    )
  }

  {
    !full && (
      <p class="activity-story__links">
        <a href="/about-this-site/#activity">See the full chart and what changed</a>
        {studyHref && <a href={studyHref}>See it in practice</a>}
      </p>
    )
  }
</div>
