---
// Stands in for the plain <a> in Markdown and MDX content (see the
// `components` prop on <Content /> in pages/work/[slug].astro), so a link
// written as [text](https://...) is routed through ExternalLink like any
// other off-site link. Relative and same-site links stay plain.
import type { HTMLAttributes } from 'astro/types';
import ExternalLink from './ExternalLink.astro';

type Props = HTMLAttributes<'a'>;

const { href, rel, target, ...attrs } = Astro.props;
const external = typeof href === 'string' && /^((https?:)?\/\/|mailto:|tel:)/i.test(href);
---

{
  external ? (
    <ExternalLink {...attrs} href={href}>
      <slot />
    </ExternalLink>
  ) : (
    <a {...attrs} href={href} rel={rel} target={target}>
      <slot />
    </a>
  )
}
