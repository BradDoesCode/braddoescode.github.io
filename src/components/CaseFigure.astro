---
// A picture in a case study, with a caption. It goes through astro:assets
// (<Picture>: AVIF and WebP with a JPG fallback, explicit sizes), so the image
// files are optimised and carry no metadata.
//
// 'scroll' is for a wide strip. It sits in its own horizontally scrollable
// region (a <section> with a name, which is the region role), a landmark the
// keyboard can focus, so the page itself never
// scrolls sideways at 320px. The strip is shown at a fixed height and keeps its
// proportions, so it is scrolled at every width, not squeezed to fit.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Panel {
  image: ImageMetadata;
  alt: string;
  /** Widths to generate, in pixels. */
  widths: number[];
  /** The 'sizes' attribute: how wide the image is shown. */
  sizes: string;
}

interface Props {
  /** One or more images, shown in order. In a scroll region they sit side by
   *  side with a small gap, so separate groups read as separate. */
  panels: Panel[];
  /** Put a wide strip in a horizontally scrollable region. */
  scroll?: boolean;
  /** The accessible name of the scrollable region. */
  regionLabel?: string;
  /** Load straight away, for an image near the top of the page. */
  eager?: boolean;
}

const { panels, scroll = false, regionLabel, eager = false } = Astro.props;
---

<figure class="case-figure case-figure--strip">
  {
    scroll ? (
      <section class="case-figure__scroll" aria-label={regionLabel} tabindex="0">
        {panels.map((p) => (
          <Picture
            class="case-figure__img"
            src={p.image}
            alt={p.alt}
            widths={p.widths}
            sizes={p.sizes}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading={eager ? 'eager' : 'lazy'}
            pictureAttributes={{ class: 'case-figure__picture' }}
          />
        ))}
      </section>
    ) : (
      panels.map((p) => (
        <Picture
          class="case-figure__img"
          src={p.image}
          alt={p.alt}
          widths={p.widths}
          sizes={p.sizes}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          loading={eager ? 'eager' : 'lazy'}
          pictureAttributes={{ class: 'case-figure__picture' }}
        />
      ))
    )
  }
  <figcaption class="illus-caption"><slot /></figcaption>
</figure>
