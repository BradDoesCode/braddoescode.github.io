---
// A picture in a case study, with a caption. It goes through astro:assets
// (<Picture>: AVIF and WebP with a JPG fallback, explicit sizes), so the image
// files are optimised and carry no metadata.
//
// 'scroll' is for a wide strip. It sits in its own horizontally scrollable
// region (a <section> with a name, which is the region role), a landmark the
// keyboard can focus, so the page itself never
// scrolls sideways at 320px. The strip is shown at a fixed height and keeps its
// proportions, so it is scrolled at every width, not squeezed to fit.
//
// 'fit' is for a single picture that should simply fill the column, such as
// a screenshot. It drops the fixed strip height: the image fills the column, up
// to a maximum height, scales down on narrow screens and never scrolls sideways.
// Use it instead of 'scroll', not with it. With 'fit' and two or more panels the
// pictures sit side by side in a row of equal squares (two columns from 40rem,
// one column below), cropped slightly to match, under one caption. Use it for
// pictures that are close to square. A panel in a pair can set 'focus' to
// 'left' or 'right' to keep that side of the picture when it is cropped (the
// default is the centre), for a wider picture whose subject is off to one side.
//
// Every picture opens full size. Its <Picture> sits inside a button that points
// (popovertarget) at a popover, a native top-layer panel that needs no script:
// the whole uncropped image, a Close button, Escape or a click outside to dismiss,
// and focus back on the picture afterwards. The large image is lazy and sits
// inside a closed popover (display: none), so it is not fetched until the viewer
// opens. Where the Popover API is missing the button does nothing and the inline
// picture still shows. The viewers sit just before the caption, outside the
// scroll region and the pair grid, so they never affect the layout.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Panel {
  image: ImageMetadata;
  alt: string;
  /** Widths to generate, in pixels. */
  widths: number[];
  /** The 'sizes' attribute: how wide the image is shown. */
  sizes: string;
  /** In a pair, which side to keep when the picture is cropped to a square.
   *  Defaults to the centre. */
  focus?: 'left' | 'right';
}

interface Props {
  /** One or more images, shown in order. In a scroll region they sit side by
   *  side with a small gap between each, so every panel stands apart. */
  panels: Panel[];
  /** Put a wide strip in a horizontally scrollable region. */
  scroll?: boolean;
  /** The accessible name of the scrollable region. */
  regionLabel?: string;
  /** Load straight away, for an image near the top of the page. */
  eager?: boolean;
  /** Fill the column width at its own proportions, with no fixed height and
   *  no sideways scroll. For a single picture. */
  fit?: boolean;
}

const { panels, scroll = false, regionLabel, eager = false, fit = false } = Astro.props;
const pair = fit && !scroll && panels.length > 1;
const imgClass = (p: Panel) =>
  p.focus ? `case-figure__img case-figure__img--focus-${p.focus}` : 'case-figure__img';

// A stable id for each panel's viewer, from the image file name with the folder,
// the build hash and the extension removed, plus the panel's position.
const slug = (p: Panel) => {
  const file = p.image.src.split(/[?#]/)[0]?.split('/').pop() ?? '';
  const name = (file.split('.')[0] ?? '').toLowerCase();
  return name.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'image';
};
const viewerIds = panels.map((p, i) => `case-figure-view-${slug(p)}-${i + 1}`);

// Widths for the full-size copy: never wider than the source, which is always
// the largest.
const fullWidths = (p: Panel) =>
  [...new Set([...[480, 960, 1440, 1920, 2560].filter((w) => w < p.image.width), p.image.width])];
---

<figure
  class={
    fit
      ? pair
        ? 'case-figure case-figure--fit case-figure--pair'
        : 'case-figure case-figure--fit'
      : 'case-figure case-figure--strip'
  }
>
  {
    scroll ? (
      <section class="case-figure__scroll" aria-label={regionLabel} tabindex="0">
        {panels.map((p, i) => (
          <button type="button" class="case-figure__open" popovertarget={viewerIds[i]}>
            <Picture
              class={imgClass(p)}
              src={p.image}
              alt={p.alt}
              widths={p.widths}
              sizes={p.sizes}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading={eager ? 'eager' : 'lazy'}
              pictureAttributes={{ class: 'case-figure__picture' }}
            />
            <span class="visually-hidden">View full size</span>
          </button>
        ))}
      </section>
    ) : (
      <div class={pair ? 'case-figure__pair' : undefined}>
        {panels.map((p, i) => (
          <button type="button" class="case-figure__open" popovertarget={viewerIds[i]}>
            <Picture
              class={imgClass(p)}
              src={p.image}
              alt={p.alt}
              widths={p.widths}
              sizes={p.sizes}
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading={eager ? 'eager' : 'lazy'}
              pictureAttributes={{ class: 'case-figure__picture' }}
            />
            <span class="visually-hidden">View full size</span>
          </button>
        ))}
      </div>
    )
  }
  {
    panels.map((p, i) => (
      <div popover id={viewerIds[i]} class="case-figure__viewer" role="dialog" aria-label={p.alt}>
        <Picture
          class="case-figure__zoom"
          src={p.image}
          alt={p.alt}
          widths={fullWidths(p)}
          sizes="100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          loading="lazy"
          pictureAttributes={{ class: 'case-figure__zoom-picture' }}
        />
        <button
          type="button"
          class="case-figure__close"
          popovertarget={viewerIds[i]}
          popovertargetaction="hide"
          autofocus
        >
          Close
        </button>
      </div>
    ))
  }
  <figcaption class="illus-caption"><slot /></figcaption>
</figure>
