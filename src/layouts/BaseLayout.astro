---
import '../styles/global.css';
import headingFont from '../../node_modules/@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import nameRoman from '../../node_modules/@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import nameItalic from '../../node_modules/@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-italic.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contentSecurityPolicy, siteName } from '../data/site';
import { OG_HEIGHT, OG_WIDTH } from '../lib/ogSize';
import { cardPath } from '../lib/ogPath';

interface Props {
  /** Page-specific title. Becomes "<title> | Bradley Barbrook". */
  title: string;
  /** Unique meta description for this page. */
  description: string;
  /** Home uses the site name as its whole title. */
  isHome?: boolean;
  /** Keep a page out of search results (used by the 404 page). */
  noindex?: boolean;
  /**
   * The name is set large above the fold: preload its display font. 'roman' for
   * the CV, 'both' for the home hero, which also sets the surname in italic.
   */
  displayName?: 'roman' | 'both';
  /** Open Graph type: 'article' for a case study, 'website' for everything else. */
  ogType?: 'website' | 'article';
}

const { title, description, isHome = false, noindex = false, displayName, ogType = 'website' } = Astro.props;

const fullTitle = isHome ? `${siteName}, software developer` : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The link-preview card for this page, drawn at build time (src/pages/og/).
// Built from the `site` config, so a custom domain changes in one place only.
const cardTitle = isHome ? siteName : title;
const ogImage = new URL(cardPath(Astro.url.pathname), Astro.site);
const ogImageAlt = `Preview card titled "${cardTitle}". ${description}`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="content-security-policy" content={contentSecurityPolicy} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f0e5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141310" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    {
      displayName && (
        <>
          <link rel="preload" href={nameRoman} as="font" type="font/woff2" crossorigin />
          {displayName === 'both' && <link rel="preload" href={nameItalic} as="font" type="font/woff2" crossorigin />}
        </>
      )
    }
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <SiteHeader />

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <SiteFooter />
  </body>
</html>
